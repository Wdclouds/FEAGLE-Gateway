# ==============================================================================
# FEAGLE WxBot 全栈生态统一配置模板 (.env.example)
# ==============================================================================
# 复制为 .env 后填入真实凭据：cp .env.example .env
# 严禁将含真实秘钥的 .env 提交至代码仓库！
# ==============================================================================

# [1] 基础运行与时区
TZ=Asia/Shanghai
BOT_TIMEZONE=Asia/Shanghai
BOT_QUIET_HOURS=00:00-07:00
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# [2] Bridge 端口与移动真机配对
DASHBOARD_HOST_PORT=6190
ANDROID_WS_BIND_HOST=0.0.0.0
ANDROID_WS_HOST_PORT=6191
ANDROID_WS_PORT=6191
ANDROID_WS_PATH=/android
ANDROID_BRIDGE_TOKEN=replace_with_a_secure_random_token_32_chars_min
ANDROID_HEARTBEAT_TIMEOUT_MS=75000
ANDROID_COMMAND_TIMEOUT_MS=30000
ANDROID_CONTACTS_SYNC_INTERVAL_MS=1800000
ANDROID_CONTACTS_SYNC_TIMEOUT_MS=25000
ONEBOT_WS_URL=ws://127.0.0.1:6199/ws

# [3] 四层漏斗网关 (apps/gateway)
GATEWAY_PORT=6185
GATEWAY_INBOUND_URL=http://127.0.0.1:6185/inbound
GATEWAY_OUTBOUND_PORT=6192
BRIDGE_OUT_URL=http://127.0.0.1:6192/gw/outbound
ADMIN_WXIDS=wxid_replace_with_admin_wxid
DEBOUNCE_MS=2000

# [4] L1 路由与多模态大模型 (Antigravity / DeepSeek)
ANTIGRAVITY_BASE_URL=http://127.0.0.1:8045/v1
ANTIGRAVITY_KEY=replace_with_antigravity_key
ANTIGRAVITY_MODEL=gemini-3.8-flash
ANTIGRAVITY_TIMEOUT_MS=15000
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_KEY=replace_with_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# [5] L2 DeepSeek Harness (dsh --profile acp)
DSH_NODE_BIN=/opt/node24/bin/node
DSH_BIN=/opt/dsh/node_modules/.bin/dsh
DSH_HOME=/opt/dsh-home
DSH_PROFILE=acp
DSH_DEFAULT_CWD=/opt/FEAGLEwxbot
DSH_PROVIDER=antigravity
DSH_MODEL=gemini-3.8-flash
DSH_FALLBACK_PROVIDER=deepseek-official
DSH_FALLBACK_MODEL=deepseek-flash
DSH_PERMISSION_MODE=default
DSH_IDLE_TIMEOUT_MS=180000
DSH_MAX_OLD_SPACE=256

# [6] Mnemosyne 长期记忆中枢
MNEMOSYNE_BASE_URL=http://127.0.0.1:18010
MN_USER_ID=eagle
MNEMOSYNE_DB_USER=hermes
MNEMOSYNE_DB_PASSWORD=replace_with_db_password
MNEMOSYNE_DB_NAME=mnemosyne

# [7] 可选工具凭据（联网搜索 / 镜像）
TAVILY_API_KEYS=
NODE_IMAGE=node:22-alpine
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
NPM_REGISTRY=https://registry.npmmirror.com
